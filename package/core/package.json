{
  "name": "@uselessworks/svgify",
  "version": "0.1.0",
  "description": "TypeScript image-to-SVG converter with print-oriented color quantization and vectorization.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uselessworks-lab/svgify.git",
    "directory": "package/core"
  },
  "homepage": "https://github.com/uselessworks-lab/svgify/tree/main/package/core#readme",
  "bugs": "https://github.com/uselessworks-lab/svgify/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "image-to-svg",
    "svg",
    "color-quantization",
    "3d-printing",
    "vectorization",
    "oklab"
  ]
}
